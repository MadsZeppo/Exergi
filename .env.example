DATABASE_URL=postgresql+psycopg://commercial_twin:change-me@localhost:5432/commercial_twin
MERCHANT_SECRET_REFERENCE=replace-with-secret-manager-reference
ENABLE_WRITE_CONNECTORS=false
API_PORT=8000

# Exergi Shopify vertical slice. Generate each key independently; never reuse keys.
EXERGI_ENVIRONMENT=development
EXERGI_API_BASE_URL=http://localhost:8000
EXERGI_DASHBOARD_URL=http://localhost:3000
SHOPIFY_CLIENT_ID=replace-from-shopify-dev-dashboard
SHOPIFY_CLIENT_SECRET=replace-from-secret-manager
# Generate with: python -c 'from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())'
SHOPIFY_TOKEN_ENCRYPTION_KEY=replace-with-fernet-key
SHOPIFY_OAUTH_STATE_KEY=replace-with-at-least-32-random-bytes
CUSTOMER_PSEUDONYM_KEY=replace-with-at-least-32-random-bytes
TENANT_PROVISIONING_KEY=replace-with-new-independent-at-least-32-random-bytes
CLERK_ISSUER_URL=https://your-clerk-frontend-api
CLERK_JWKS_URL=https://your-clerk-frontend-api/.well-known/jwks.json
CLERK_AUTHORIZED_PARTIES=http://localhost:3000,https://exergi.vercel.app
# Set only when the Clerk JWT template/configuration emits and requires this audience.
CLERK_AUDIENCE=
SHOPIFY_ENABLE_READ_ALL_ORDERS=false
SHOPIFY_ENABLE_PAYMENTS_DATA=false
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=replace-from-clerk-dashboard
CLERK_SECRET_KEY=replace-from-clerk-dashboard
NEXT_PUBLIC_EXERGI_API_URL=http://localhost:8000
NEXT_PUBLIC_EXERGI_DEMO_MODE=false
